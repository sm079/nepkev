# Copy to .env (never committed) and fill in what you use.

# Generation and verification (Anthropic API)
ANTHROPIC_API_KEY=

# Optional model overrides of configs/generation/<name>.yaml
# NEPKEV_GEN_PROVIDER=anthropic          # anthropic | dry_run
# NEPKEV_GEN_MODEL=claude-sonnet-5-5
# NEPKEV_VERIFY_PROVIDER=anthropic
# NEPKEV_VERIFY_MODEL=claude-haiku-5-5

# Remote training (nepkev remote-train); a Windows user variable is also read from the registry
# RUNPOD_API_KEY=

# Routing API (nepkev.service); defaults in nepkev/service/settings.py
# NEPKEV_DATABASE_URL=postgresql+psycopg://nepkev:nepkev@localhost:5432/nepkev
# NEPKEV_DEFAULT_CHANNEL=wallet          # shop | wallet | bank, when a request names none
# NEPKEV_DTYPE=fp32                      # fp32 | bf16 (faster on CPUs with native bf16)
# NEPKEV_TORCH_THREADS=
# NEPKEV_MIN_CONFIDENCE=0.5              # ask the customer when the top category is less likely than this
# NEPKEV_LOG_TEXT=false                  # store raw message text in route_requests (a SHA-256 is always stored)
# Tests that need Postgres run only with this set; the database is wiped
# NEPKEV_TEST_DATABASE_URL=postgresql+psycopg://nepkev:nepkev@localhost:5432/nepkev_test

# docker compose (docker-compose.yml)
# POSTGRES_PASSWORD=nepkev
# NEPKEV_API_PORT=8000
